# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
# DB_URL: MongoDB-compatible Cloud Firestore connection string
DB_URL="mongodb://username:password@instance.firestore.goog:443/dbname"

# Firebase Client Web App Auth Credentials (From Firebase Console > Project Settings)
FIREBASE_API_KEY="AIzaSyYourRealKeyFromFirebaseConsole"
FIREBASE_AUTH_DOMAIN="portfolist-a3725.firebaseapp.com"
FIREBASE_PROJECT_ID="portfolist-a3725"
FIREBASE_STORAGE_BUCKET="portfolist-a3725.firebasestorage.app"
FIREBASE_MESSAGING_SENDER_ID="1029384756"
FIREBASE_APP_ID="1:1029384756:web:abcd1234efgh"

# portfolist github app, for agent repository walking
GITHUB_APP_CLIENT_NAME="portfolist"
GITHUB_APP_CLIENT_ID=""

# portfolist github oauth app, for login
GITHUB_AUTH_CLIENT_ID=""